# Copy to .env.local. No real credentials are included.
# Demo mode uses a local JSON store and never fulfills an order.
DEMO_MODE=true
MONGODB_URI=
PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
# Set a long random private key to enable /admin. Never use NEXT_PUBLIC_ here.
ADMIN_API_KEY=
PUBLIC_APP_URL=http://localhost:3000
# Development default: work/uploads. In production use an absolute durable volume.
UPLOAD_DIR=
# Optional real SMTP delivery. Without this, notices remain in-app / unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
